<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <!-- Same lesson as LabMonitoring.Agent/LabMonitoring.Agent.RemoteHelper (ADR-0013): leaving this
         true breaks locale-dependent native/managed init in ways that are painful to diagnose. -->
    <InvariantGlobalization>false</InvariantGlobalization>
    <AssemblyName>LabMonitoring.Agent.Updater</AssemblyName>
  </PropertyGroup>

</Project>
