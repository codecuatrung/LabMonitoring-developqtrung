{
  "Agent": {
    "ServerBaseUrl": "http://localhost:5200",
    "RoomCode": "",
    "HeartbeatSeconds": 5,
    "OutboxCapacity": 500
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": { "Microsoft": "Warning", "System.Net.Http": "Warning" }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "%ProgramData%/LabMonitoring/Agent/logs/agent-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 14
        }
      }
    ],
    "Enrich": [ "FromLogContext" ],
    "Properties": { "Application": "LabMonitoring.Agent" }
  }
}
