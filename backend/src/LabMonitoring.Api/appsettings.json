{
  "ConnectionStrings": {
    "SqlServer": "Server=MVT;Database=LabMonitoring;User Id=sa;Password=CHANGE_ME;TrustServerCertificate=True;Encrypt=True;MultipleActiveResultSets=True",
    "Redis": "localhost:6379"
  },
  "Keycloak": {
    "Authority": "https://sso2.huph.edu.vn/realms/coreproject",
    "InternalAuthority": "https://sso2.huph.edu.vn/realms/coreproject",
    "Audience": "labmonitoring-api",
    "RequireHttpsMetadata": true,
    "ClientSecret": ""
  },
  "Auth": {
    "BootstrapAdmins": []
  },
  "AgentDefaults": {
    "HeartbeatSeconds": 5,
    "OfflineThresholdSeconds": 30,
    "ScreenshotIntervalSeconds": 60
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:4300" ]
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.Seq" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      { "Name": "Seq", "Args": { "serverUrl": "http://localhost:5341" } }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId" ],
    "Properties": { "Application": "LabMonitoring.Api" }
  },
  "AllowedHosts": "*"
}
