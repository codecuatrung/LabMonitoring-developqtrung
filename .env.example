# Copy to .env for docker-compose / local overrides. Do NOT commit .env.
# --- Keycloak ---
KEYCLOAK__AUTHORITY=https://sso2.huph.edu.vn/realms/coreproject
KEYCLOAK__AUDIENCE=labmonitoring-api
# labmonitoring-api client secret (Keycloak > Clients > Credentials). Not used by JWT validation;
# needed only if the backend calls the Keycloak Admin API later. Dev: use `dotnet user-secrets`.
KEYCLOAK__CLIENTSECRET=
# preferred_username / email granted Administrator on first sign-in (bootstrap the first admin)
AUTH__BOOTSTRAPADMINS__0=

# SQL Server (native install on this machine)
CONNECTIONSTRINGS__SQLSERVER=Server=MVT;Database=LabMonitoring;User Id=sa;Password=changeme;TrustServerCertificate=True;Encrypt=True

# Redis (deploy/docker-compose.dev.yml)
CONNECTIONSTRINGS__REDIS=localhost:6379

# Seq
SERILOG__WRITETO__1__ARGS__SERVERURL=http://localhost:5341

# MinIO / screenshot storage (M4)
STORAGE__ENDPOINT=http://localhost:9000
STORAGE__ACCESSKEY=labmonitoring
STORAGE__SECRETKEY=changeme
STORAGE__BUCKET=screenshots
