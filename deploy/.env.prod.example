# Copy to deploy/.env (git-ignored) and fill in. Used by docker-compose.prod.yml.

# IP or DNS name browsers use to open the web admin (must match the certificate and the SSO client URLs).
SERVER_HOST=192.168.1.28

# Existing SQL Server (not in Docker). SQL login with db_owner on DB_NAME (see docs/DEPLOY.md, section 2).
DB_HOST=192.168.1.168
DB_PORT=1433
DB_NAME=LabMonitoring
DB_USER=labmonitoring
DB_PASSWORD=ChangeMe_Str0ng!Pass

# SSO issuer (realm URL). Leave as is unless the realm moves.
SSO_AUTHORITY=https://sso2.huph.edu.vn/realms/coreproject

# preferred_username (or email) that becomes Administrator on first sign-in of a fresh database.
BOOTSTRAP_ADMIN=mvt